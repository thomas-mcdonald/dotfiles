#!/usr/bin/env bash
# Fast bash replacement for git_cwd_info

# Get git directory
git_repo_path=$(git rev-parse --git-dir 2>/dev/null)

# Exit early if not in a git repo or in home directory
if [[ -z "$git_repo_path" ]] || [[ "$git_repo_path" == "$HOME/.git" ]]; then
  exit 0
fi

# Get branch name (fastest method - read HEAD directly)
if [[ -f "$git_repo_path/HEAD" ]]; then
  branch=$(< "$git_repo_path/HEAD")
  branch=${branch#ref: refs/heads/}
else
  exit 0
fi

# Get short commit ID
commit=$(git rev-parse --short HEAD 2>/dev/null)

# Check for special states
state=""
if [[ -f "$git_repo_path/BISECT_LOG" ]]; then
  state="+bisect"
elif [[ -f "$git_repo_path/MERGE_HEAD" ]]; then
  state="+merge"
elif [[ -d "$git_repo_path/rebase-merge" ]] || [[ -d "$git_repo_path/rebase-apply" ]]; then
  state="+rebase"
fi

# Check for dirty working directory (skip if git_repo_path is current dir)
dirty=""
if [[ "$git_repo_path" != "." ]]; then
  # Fast dirty check - only check if there are modified files
  if ! git diff --quiet 2>/dev/null || ! git diff --cached --quiet 2>/dev/null; then
    dirty=" %{$(echo -e "\e[90m")%}✗%{$(echo -e "\e[0m")%}"
  fi
fi

# Print the prompt info
printf " %%{$(echo -e "\e[34m")%%}%s%%{$(echo -e "\e[90m")%%}@%%{$(echo -e "\e[33m")%%}%s%%{$(echo -e "\e[0m")%%}%s%s" "$branch" "$commit" "$state" "$dirty"

# frozen_string_literal: true

# History saving is built into modern irb — just keep more of it.
IRB.conf[:SAVE_HISTORY] = 10_000
IRB.conf[:HISTORY_FILE] = File.expand_path("~/.irb_history")

IRB.conf[:PROMPT_MODE] = :SIMPLE

# Type-aware autocompletion (Prism-based). Ships with Ruby 3.4 for plain irb;
# inside a bundled app (e.g. `rails console`) it needs `gem "repl_type_completor"`
# in the Gemfile's development group, otherwise this quietly falls back to the
# default regexp completor.
begin
  require "repl_type_completor"
  IRB.conf[:COMPLETOR] = :type
rescue LoadError
end

class Object
  # Methods defined by this object's class itself, not inherited ones.
  def local_methods(obj = self)
    (obj.methods - obj.class.superclass.instance_methods).sort
  end
end

# Rails console shortcut: reload the app.
def r
  reload!
end
